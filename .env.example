# Copy to .env and adjust. NEVER commit the real .env file.
NODE_ENV=development
PORT=3000

# Required in production (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-48-byte-random-secret

JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
DB_PATH=./data/app.db
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

{
  "name": "secure-notes-api",
  "version": "1.0.0",
  "private": true,
  "description": "Secure REST API (Express + SQLite) built for Laboratory Work 1: JWT auth, bcrypt password hashing, parameterized SQL, XSS-safe output, CI/CD security scanning.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "dev": "node --watch src/server.js",
    "test": "node test/api.test.js",
    "test:all": "node --test",
    "lint": "eslint .",
    "sast": "eslint . --format json --output-file reports/eslint-sast.json",
    "sca": "npm audit --audit-level=high",
    "audit:json": "npm audit --json > reports/npm-audit.json || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^3.0.1"
  }
}
